{
    "name": "Nightscout Extension",
    "version": "1.0.0",
    "description": "A Firefox extension that adds a convenient way to check blood sugar data from Nightscout in your browser.",
    "content_security_policy": "script-src 'self'; object-src 'self'",
    "permissions": ["storage","https://*.fly.dev/", "notifications"],
    "optional_permissions":["https://*/"],
    "background": {
      "scripts": ["background.js"]
    },
    "browser_action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "images/nightscout16.png",
        "32": "images/nightscout32.png",
        "48": "images/nightscout48.png",
        "128": "images/nightscout128.png"
      }
    },
    "icons": {
      "16": "images/nightscout16.png",
      "32": "images/nightscout32.png",
      "48": "images/nightscout48.png",
      "128": "images/nightscout128.png"
    },
    "manifest_version": 2
  }